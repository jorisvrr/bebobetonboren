# SMTP voor offerteaanvragen. Op Vercel VERPLICHT: zonder werkende SMTP krijgt
# de bezoeker een foutmelding in plaats van de bedankpagina.
SECRET_KEY=een-lange-willekeurige-string
SMTP_HOST=smtp.jouwprovider.nl
SMTP_PORT=587
SMTP_USER=info@bebobetonboren.nl
SMTP_PASS=jouw-wachtwoord
SMTP_FROM=info@bebobetonboren.nl
# Ontvanger van offerteaanvragen (klanten)
MAIL_TO=info@bebobetonboren.nl
# Alleen voor het oude /intake-formulier op deze site; leeg = geen intake-mail.
# Nooit het bedrijfsadres invullen. Het losse intakeformulier (bebointake) staat hier los van.
INTAKE_MAIL_TO=

# Canoniek domein (canonical, Open Graph, sitemap, JSON-LD)
SITE_URL=https://bebobetonboren.nl

# Lettertype-preview: titillium (standaard) of off voor het oorspronkelijke lettertype
FONT_PREVIEW=titillium
